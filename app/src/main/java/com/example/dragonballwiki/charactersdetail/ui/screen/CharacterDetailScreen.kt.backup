@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun CharacterDetailScreen(
    characterDetailViewModel: CharacterDetailViewModel = koinViewModel(),
    onBackClick: () -> Unit = {}
) {
    val state = characterDetailViewModel.state

    when {
        state.error?.isNotEmpty().isTrue() -> {
            ErrorStateCompose(
                title = "Error loading character",
                description = state.error ?: "Unknown error occurred",
                onRetryClick = { /* Character will reload on init */ }
            )
        }

        state.loading -> {
            LoginBall(stringResource(R.string.character_detail_label_loading))
        }

        state.characterDetail != null -> {
            Scaffold(
                topBar = {
                    TopAppBar(
                        title = {
                            Text(
                                text = state.characterDetail.name,
                                style = MaterialTheme.typography.titleLarge,
                                fontWeight = FontWeight.Bold,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )
                        },
                        navigationIcon = {
                            IconButton(onClick = onBackClick) {
                                Icon(
                                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                                    contentDescription = "Back",
                                    tint = MaterialTheme.colorScheme.onPrimary
                                )
                            }
                        },
                        colors = TopAppBarDefaults.topAppBarColors(
                            containerColor = MaterialTheme.colorScheme.primary,
                            titleContentColor = MaterialTheme.colorScheme.onPrimary
                        )
                    )
                }
            ) { paddingValues ->
                CharacterDetail(
                    characterDetailVO = state.characterDetail,
                    modifier = Modifier.padding(paddingValues)
                )
            }
        }
    }
}

@Composable
fun CharacterDetail(
    characterDetailVO: CharacterDetailVO,
    modifier: Modifier = Modifier
) {
    Column(
        modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
    ) {
        // Hero Section with Image
        Card(
            modifier = Modifier
                .fillMaxWidth()
                .padding(Spacing.medium)
        ) {
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(MaterialTheme.colorScheme.surfaceVariant)
            ) {
                ImageCharacter(
                    characterDetailVO.image,
                    Modifier
                        .fillMaxWidth()
                        .size(300.dp)
                        .padding(Spacing.medium)
                )
                
                NameCharacter(
                    nameCharacter = characterDetailVO.name,
                    isDetail = false,
                    modifier = Modifier
                        .align(Alignment.CenterHorizontally)
                        .padding(bottom = Spacing.small)
                )
            }
        }

        // Stats Section
        Text(
            text = "Character Stats",
            style = MaterialTheme.typography.titleLarge,
            fontWeight = FontWeight.Bold,
            modifier = Modifier.padding(
                start = Spacing.medium,
                end = Spacing.medium,
                top = Spacing.medium,
                bottom = Spacing.small
            )
        )

        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = Spacing.medium),
            horizontalArrangement = Arrangement.spacedBy(Spacing.small)
        ) {
            StatCard(
                title = "Race",
                value = characterDetailVO.race,
                modifier = Modifier.weight(1f)
            )
            StatCard(
                title = "Gender",
                value = characterDetailVO.gender,
                modifier = Modifier.weight(1f)
            )
        }

        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = Spacing.medium, vertical = Spacing.small),
            horizontalArrangement = Arrangement.spacedBy(Spacing.small)
        ) {
            StatCard(
                title = "Base Ki",
                value = characterDetailVO.ki,
                modifier = Modifier.weight(1f)
            )
            StatCard(
                title = "Max Ki",
                value = characterDetailVO.maxKi,
                modifier = Modifier.weight(1f)
            )
        }

        StatCard(
            title = "Affiliation",
            value = characterDetailVO.affiliation,
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = Spacing.medium)
        )

        // Description Section
        if (characterDetailVO.description.isNotEmpty()) {
            Text(
                text = "Description",
                style = MaterialTheme.typography.titleLarge,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(
                    start = Spacing.medium,
                    end = Spacing.medium,
                    top = Spacing.large,
                    bottom = Spacing.small
                )
            )
            
            Card(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = Spacing.medium)
            ) {
                Text(
                    text = characterDetailVO.description,
                    style = MaterialTheme.typography.bodyMedium,
                    modifier = Modifier.padding(Spacing.medium)
                )
            }
        }

        // Transformations Section
        if (characterDetailVO.transformations.isNotEmpty()) {
            Text(
                text = stringResource(R.string.character_detail_label_transformations),
                style = MaterialTheme.typography.titleLarge,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(
                    start = Spacing.medium,
                    end = Spacing.medium,
                    top = Spacing.large,
                    bottom = Spacing.small
                )
            )
            
            LazyRow(
                contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = Spacing.medium),
                horizontalArrangement = Arrangement.spacedBy(Spacing.small)
            ) {
                items(characterDetailVO.transformations, key = { it.id }) {
                    ItemTransformation(it)
                }
            }
        }
        
        // Cache Indicator
        if (characterDetailVO.isFromCache && characterDetailVO.lastUpdated != null) {
            CacheIndicator(
                lastUpdated = characterDetailVO.lastUpdated,
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(Spacing.medium)
            )
        }
        
        Spacer(modifier = Modifier.size(Spacing.large))
    }
}

@Composable
fun StatCard(
    title: String,
    value: String,
    modifier: Modifier = Modifier
) {
    Card(
        modifier = modifier
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(Spacing.medium)
        ) {
            Text(
                text = title,
                style = MaterialTheme.typography.labelMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant,
                fontWeight = FontWeight.Medium
            )
            Spacer(modifier = Modifier.size(Spacing.extraSmall))
            Text(
                text = value.ifEmpty { "Unknown" },
                style = MaterialTheme.typography.bodyLarge,
                fontWeight = FontWeight.Bold,
                color = MaterialTheme.colorScheme.onSurface
            )
        }
    }
}

@Composable
fun CacheIndicator(
    lastUpdated: Long,
    modifier: Modifier = Modifier
) {
    val currentTime = System.currentTimeMillis()
    val diffInMillis = currentTime - lastUpdated
    val diffInDays = TimeUnit.MILLISECONDS.toDays(diffInMillis)
    
    val (emoji, text, backgroundColor) = when {
        diffInDays == 0L -> Triple("📡", "Updated today", MaterialTheme.colorScheme.primaryContainer)
        diffInDays < 5 -> Triple("✅", "Updated $diffInDays day${if (diffInDays > 1) "s" else ""} ago", MaterialTheme.colorScheme.tertiaryContainer)
        diffInDays < 10 -> Triple("⚠️", "Updated $diffInDays days ago", MaterialTheme.colorScheme.secondaryContainer)
        else -> Triple("⚠️", "Data may be outdated ($diffInDays days old)", MaterialTheme.colorScheme.errorContainer)
    }
    
    Surface(
        modifier = modifier.clip(RoundedCornerShape(Spacing.small)),
        color = backgroundColor
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(Spacing.medium),
            horizontalArrangement = Arrangement.Center,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(text = emoji, fontSize = 16.sp)
            Spacer(modifier = Modifier.size(Spacing.small))
            Text(
                text = text,
                style = MaterialTheme.typography.bodySmall,
                fontWeight = FontWeight.Medium,
                color = MaterialTheme.colorScheme.onSurface
            )
        }
    }
}

@Composable
fun ItemTransformation(item: Transformation) {
    Card(
        modifier = Modifier.size(width = 160.dp, height = 220.dp)
    ) {
        Column(
            Modifier
                .fillMaxSize()
                .padding(Spacing.small),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            ImageCharacter(
                urlImage = item.image,
                modifier = Modifier
                    .size(100.dp)
            )
            Spacer(modifier = Modifier.size(Spacing.small))
            Text(
                text = item.name,
                style = MaterialTheme.typography.bodyMedium,
                fontWeight = FontWeight.Bold,
                maxLines = 2,
                overflow = TextOverflow.Ellipsis,
                modifier = Modifier.padding(horizontal = Spacing.extraSmall)
            )
            Text(
                text = "Ki: ${item.ki}",
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.primary,
                modifier = Modifier.padding(top = Spacing.extraSmall)
            )
        }
    }
}

